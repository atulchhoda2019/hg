# Copy to stay_agent/.env (adk web reads it there) or export in your shell.
# Gemini Developer API: create a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Vertex AI instead (same code path; ADK switches on these two):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

STAY_GEMINI_MODEL=gemini-2.5-flash
STAY_GEMMA_MODEL=gemma-3-27b-it

# table | gemini_only | gemma_only | rules_only
STAY_DECIDER_MODE=table

# model | fixture. Default: model when a key is present, fixture otherwise.
# STAY_CLASSIFIER=fixture
# STAY_EXTRACTOR=fixture

# Where the attribute store, escalation queue and golden labels live.
STAY_STATE_DIR=.stay_state

# Fault drills, one per line, set to 1 to arm.
# RATE_CHANGED_ONCE=1
# SOLD_OUT_AFTER_PREVIEW=1
# CRS_TIMEOUT_ONCE=1
# MODEL_PRICE_HALLUCINATION=1
# EXTRACTOR_HALLUCINATE_ROOM=1
# CONNECTING_ASYMMETRY=1
# DUPLICATE_CONFIRM=1
